# ==============================================================================
# SEPTA-Ops Environment Configuration
# ==============================================================================

# Database Settings (PostgreSQL 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=septa_ops
POSTGRES_USER=septa_admin
POSTGRES_PASSWORD=septa_secure_password

# Admin connection string (for ETL and schema migrations)
DATABASE_URL=postgresql://septa_admin:septa_secure_password@localhost:5432/septa_ops

# Least-privilege read-only connection string (for Agent SQL queries)
READONLY_DATABASE_URL=postgresql://readonly_copilot:readonly_secret@localhost:5432/septa_ops

# LLM Providers (Configure at least one for Copilot agent)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Configuration
# Options: openai (text-embedding-3-small), huggingface (all-MiniLM-L6-v2), or local_mock
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Model & Agent Settings
AGENT_MODEL_NAME=gpt-4o-mini
DEFAULT_ROW_LIMIT=100
MAX_ROW_LIMIT=500
STATEMENT_TIMEOUT_MS=10000

# Streamlit App
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
